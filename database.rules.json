{
  "rules": {
    "staff": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() === true && root.child('staff').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('staff').child(auth.uid).child('active').val() === true && root.child('staff').child(auth.uid).child('role').val() === 'admin'))",
        ".write": "auth != null && auth.uid !== $uid && root.child('staff').child(auth.uid).child('active').val() === true && root.child('staff').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['role','active','displayName','email']) && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'moderator') && newData.child('active').isBoolean() && newData.child('displayName').isString() && newData.child('displayName').val().length <= 60 && newData.child('email').isString() && newData.child('email').val().length <= 254 && (!newData.child('createdAt').exists() || newData.child('createdAt').isNumber())",
        "role": {
          ".validate": "newData.isString()"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "audience": {
      "$event": {
        "open": {
          ".read": true,
          ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() === true && (root.child('staff').child(auth.uid).child('role').val() === 'moderator' || root.child('staff').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.isBoolean()"
        },
        "suggestions": {
          ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() === true && (root.child('staff').child(auth.uid).child('role').val() === 'moderator' || root.child('staff').child(auth.uid).child('role').val() === 'admin')",
          "$id": {
            ".write": "(!data.exists() && newData.exists() && root.child('audience').child($event).child('open').val() === true) || (data.exists() && !newData.exists() && auth != null && root.child('staff').child(auth.uid).child('active').val() === true && (root.child('staff').child(auth.uid).child('role').val() === 'moderator' || root.child('staff').child(auth.uid).child('role').val() === 'admin'))",
            ".validate": "newData.hasChildren(['w','t','d']) && newData.child('w').isString() && newData.child('w').val().length >= 2 && newData.child('w').val().length <= 24 && newData.child('w').val().matches(/^[^ <>\"&]+$/) && newData.child('t').isNumber() && newData.child('t').val() <= now + 10000 && newData.child('t').val() >= now - 60000 && newData.child('d').isString() && newData.child('d').val().length <= 40",
            "w": {
              ".validate": "newData.isString()"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "d": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "approved": {
          ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() === true && (root.child('staff').child(auth.uid).child('role').val() === 'moderator' || root.child('staff').child(auth.uid).child('role').val() === 'admin')",
          "$id": {
            ".write": "auth != null && root.child('staff').child(auth.uid).child('active').val() === true && (root.child('staff').child(auth.uid).child('role').val() === 'moderator' || root.child('staff').child(auth.uid).child('role').val() === 'admin') && ((!data.exists() && newData.exists() && newData.child('by').val() === auth.uid) || (data.exists() && !newData.exists()))",
            ".validate": "newData.hasChildren(['w','by','t']) && newData.child('w').isString() && newData.child('w').val().length >= 2 && newData.child('w').val().length <= 24 && newData.child('by').isString() && newData.child('by').val() === auth.uid && newData.child('t').isNumber() && newData.child('t').val() <= now + 10000",
            "w": {
              ".validate": "newData.isString()"
            },
            "by": {
              ".validate": "newData.isString()"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sessions": {
      "$code": {
        ".read": "auth != null && (auth.token.email_verified === true || root.child('staff').child(auth.uid).child('active').val() === true)",
        ".validate": "$code.matches(/^[A-Za-z0-9_-]{3,16}$/)",
        "state": {
          ".write": "auth != null && (auth.token.email_verified === true || root.child('staff').child(auth.uid).child('active').val() === true)",
          ".validate": "newData.hasChildren()",
          "mode": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "bpm": {
            ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 400"
          },
          "turnBars": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64"
          },
          "lenMin": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
          },
          "lenMax": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
          },
          "complexity": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "posSet": {
            ".validate": "newData.hasChildren()",
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            }
          },
          "activeCategory": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "playing": {
            ".validate": "newData.isBoolean()"
          },
          "seed": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "presence": {
          ".write": "auth != null && (auth.token.email_verified === true || root.child('staff').child(auth.uid).child('active').val() === true)",
          "$pid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "registrations": {
      ".read": "auth != null && root.child('staff').child(auth.uid).child('active').val() === true && root.child('staff').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && auth.token.email_verified === true && !data.exists() && newData.exists()) || (data.exists() && !newData.exists() && root.child('staff').child(auth.uid).child('active').val() === true && root.child('staff').child(auth.uid).child('role').val() === 'admin'))",
        ".validate": "newData.hasChildren(['email','displayName','createdAt']) && newData.child('email').isString() && newData.child('email').val().length <= 254 && newData.child('email').val().toLowerCase() === auth.token.email.toLowerCase() && newData.child('displayName').isString() && newData.child('displayName').val().length >= 2 && newData.child('displayName').val().length <= 60 && newData.child('createdAt').isNumber() && newData.child('createdAt').val() <= now + 10000 && newData.child('createdAt').val() >= now - 60000",
        "email": {
          ".validate": "newData.isString()"
        },
        "displayName": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}